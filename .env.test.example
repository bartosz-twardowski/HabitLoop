# Test credentials for Playwright smoke tests.
# Copy this file to .env.test and fill in values.
# The user must exist in the Supabase project referenced by SUPABASE_URL.

# Supabase connection — local dev only; use repo secrets in CI.
SUPABASE_URL=
SUPABASE_KEY=

# Test user credentials (must be a real account in the Supabase project above).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
